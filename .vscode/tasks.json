{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "godot:build-solutions",
      "type": "process",
      "command": "C:\\2_Workshop\\1_Application\\Godot_v4.4.1-stable_mono_win64\\Godot_v4.4.1-stable_mono_win64\\Godot_v4.4.1-stable_mono_win64.exe",
      "args": [
        "--headless",
        "--path",
        "${workspaceFolder}",
        "--build-solutions",
        "--quit"
      ],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "dotnet:build",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
